## 对局自检 —— 把 四张嘴.tscn 真的实例化出来，模拟玩家点完一整局。
##
## 跑法：
##   Godot_v4.4-stable_win64_console.exe --headless --path . --script res://脚本/测试/对局自检.gd
##
## 这个脚本管的是"界面层有没有把引擎用对"：
##   · 选底本 → 句子有没有进故事
##   · 说出口 → 下一幕有没有人接话、证人数有没有涨
##   · 换词   → 是不是全局生效
##   · 结算   → 会不会崩、最后那一句对不对
extends SceneTree

const 场景路径 := "res://场景/四张嘴.tscn"

var _通过: int = 0
var _失败: int = 0


func _ok(名: String, 条件: bool, 补充: String = "") -> void:
	if 条件:
		_通过 += 1
		print("  [OK] ", 名)
	else:
		_失败 += 1
		print("  [XX] ", 名, "　← 实际：", 补充)


func _组(名: String) -> void:
	print("")
	print("── ", 名)


func _initialize() -> void:
	print("")
	print("════════ 口径 · 对局自检（界面层）════════")
	_跑()


func _跑() -> void:
	await _第一局_救了那句()
	await _第二局_换一个词()
	await _第三局_弄丢了那句()
	await _第四局_把故事写打架()
	await _测_三种结尾()
	await _测_草稿()
	await _测_笔记()

	print("")
	print("════════ 通过 %d · 失败 %d ════════" % [_通过, _失败])
	print("")
	quit(1 if _失败 > 0 else 0)


# ============================================================
## ⚠️ 加进场景树之后必须等两帧 —— @onready 是在 _ready() 里赋值的，
##    不等就调方法，界面上那一堆 %唯一名 还全是 null。
func _开局() -> Control:
	var 实例: Control = load(场景路径).instantiate()
	root.add_child(实例)
	await process_frame
	await process_frame
	return 实例


func _收场(实例: Control) -> void:
	root.remove_child(实例)
	实例.queue_free()


# ============================================================ 第一局
## 每幕选同桌的说法；第 3 幕听到「欢迎回来」，当场说出口。
func _第一局_救了那句() -> void:
	_组("① 第一局：选同桌，第 3 幕把「欢迎回来」说出口")

	var 实例: Control = await _开局()
	var 引擎: 口径 = 实例.局.引擎

	for 幕号 in range(1, 8):
		实例._点讲者("tong")
		var 前: int = 引擎.取证人数(口径词表.结尾词)
		if 幕号 == 3:
			实例._点词(口径词表.结尾词, -1, -1)      # 从手牌里选中它
			_ok("手牌能选中「%s」" % 口径词表.结尾词, 实例.局.选中词 == 口径词表.结尾词, 实例.局.选中词)
			实例.局.说出口()
			_ok("说出口后它回到事实档", 引擎.取档(口径词表.结尾词) == 口径.档_事实, str(引擎.取清晰(口径词表.结尾词)))
			_ok("它被打上了你的金线", 引擎.是背书的(口径词表.结尾词))
		实例.局.下一幕()
		if 幕号 == 3:
			_ok("★ 下一幕有人接了你的话", not 实例.局.本幕回响.is_empty(), str(实例.局.本幕回响))
			_ok("★ 证人数涨上去了（%d → %d）" % [前, 引擎.取证人数(口径词表.结尾词)],
				引擎.取证人数(口径词表.结尾词) > 前, str(引擎.取证人数(口径词表.结尾词)))

	_ok("七幕走完，进了结算", 实例.局.完了)
	_ok("故事攒够了七句", 引擎.句子.size() == 7, str(引擎.句子.size()))
	_ok("★ 最后那句还活着", 引擎.取档(口径词表.结尾词) != 口径.档_哑,
		"清晰度 %.2f" % 引擎.取清晰(口径词表.结尾词))
	_ok("结算层建起来了", 实例.get_node_or_null("结算层") != null)
	var 手记: Array = 实例.局.手记
	_ok("手记里记下了你说出口的那次", 手记.size() == 1 and str(手记[0]["动作"]) == "说出口", str(手记))

	_打印(引擎)
	await _等(6.0)          # 让结算动画放完，顺便看有没有报错
	_收场(实例)
	await _等(0.2)


# ============================================================ 第二局
## 第 2 幕把「来找他」换成同桌的「跟了他一路」—— 验证全局替换在界面层也生效。
func _第二局_换一个词() -> void:
	_组("② 第二局：第 2 幕换一个词，看它是不是全局生效")

	var 实例: Control = await _开局()
	var 引擎: 口径 = 实例.局.引擎

	# 第 1 幕：选妈（故事里有「等一个人」）
	实例._点讲者("ma")
	实例.局.下一幕()

	# 第 2 幕：选妈（故事里有「来找他」），然后换成同桌的「跟了他一路」
	实例._点讲者("ma")
	实例._点词("跟了他一路", -1, -1)
	实例.局.开始换词()
	_ok("按「换掉」进了换词模式", 实例.局.换词模式)
	实例._点词("来找他", 1, 2)          # 点故事里那个词
	_ok("「来找他」不在故事里了", not 引擎.在故事里("来找他"))
	_ok("「跟了他一路」进故事了", 引擎.在故事里("跟了他一路"))
	_ok("记了一笔手记", 实例.局.手记.size() == 1 and str(实例.局.手记[0]["动作"]) == "换词", str(实例.局.手记))
	_ok("引擎里也有替换记录", 引擎.取替换记录().size() == 1, str(引擎.取替换记录()))
	_ok("换出来的那段历史带着新词自己的结实度（孤证 → 不是事实档）",
		引擎.取档("跟了他一路") != 口径.档_事实, str(引擎.取清晰("跟了他一路")))

	# 改说法会自动撤掉草稿（不是被禁止）—— 详细在 ⑥ 草稿那组里验
	实例._点讲者("k")
	_ok("★ 改说法会撤掉草稿，故事换成老K的说法",
		实例.局.选中讲者 == "k" and not 引擎.在故事里("跟了他一路"), str(引擎.句子))

	# 把这次换词重做一遍，验证它在后面几幕还生效（这才是本局的重点）
	实例._点讲者("ma")
	实例._点词("跟了他一路", -1, -1)
	实例.局.开始换词()
	实例._点词("来找他", 1, 2)
	_ok("重做换词成功", 引擎.在故事里("跟了他一路"), str(引擎.句子))
	实例.局.下一幕()

	# 走完剩下的
	for 幕号 in range(3, 8):
		实例._点讲者("k")
		实例.局.下一幕()

	_ok("走完了", 实例.局.完了)
	_ok("第 2 句里是新词（全局替换生效）",
		"跟了他一路" in 引擎.句子[1], str(引擎.句子[1]))
	_ok("换掉的旧词不再出现", not 引擎.在故事里("来找他"))

	_打印(引擎)
	await _等(9.0)
	_收场(实例)
	await _等(0.2)


# ============================================================ 第三局
## 第 3 幕选同桌（把「欢迎回来」写进故事），然后什么都不做 —— 看它怎么没的。
## 这是全游戏最重要的那一种落法：**"我弄丢了那句欢迎回来"**。
func _第三局_弄丢了那句() -> void:
	_组("③ 第三局：把「欢迎回来」写进故事，然后再也不管它")

	var 实例: Control = await _开局()
	var 引擎: 口径 = 实例.局.引擎

	for 幕号 in range(1, 8):
		实例._点讲者("tong" if 幕号 == 3 else "ban")
		实例.局.下一幕()

	_ok("走完了", 实例.局.完了)
	_ok("★ 它确实进过故事", 引擎.在故事里(口径词表.结尾词), str(引擎.句子))
	_ok("★ 最后没人再提它了", 引擎.取档(口径词表.结尾词) == 口径.档_哑,
		"清晰度 %.2f" % 引擎.取清晰(口径词表.结尾词))
	_ok("★ 但故事没崩：那一格还在，只是划掉了（不是丢一句话，是留一个洞）",
		引擎.在故事里(口径词表.结尾词))
	_ok("手记是空的（你一次也没出手）", 实例.局.手记.is_empty(), str(实例.局.手记))

	var 念: Array = 引擎.取故事文本()
	var 有划掉: bool = false
	for 行 in 念:
		if "〖" in str(行):
			有划掉 = true
	_ok("念故事时它是〖划掉〗的", 有划掉, str(念))

	# 三种落法里，这一局该落在"念不出来"
	var 尾: Dictionary = 实例.局.取结尾文案()
	_ok("★ 结尾落在「我念不出来」那一种", bool(尾["划掉"]) and not bool(尾["淡"]), str(尾))

	_打印(引擎)
	await _等(9.0)
	_收场(实例)
	await _等(0.2)


# ============================================================ 结尾的三种落法
## 直接验 取结尾文案() 的三个分支 —— 不用真的打完一局。
func _测_三种结尾() -> void:
	_组("⑤ 结尾那一句的三种落法")

	# ① 从来没写进故事
	var a: Control = await _开局()
	a._点讲者("ban")
	var 尾a: Dictionary = a.局.取结尾文案()
	_ok("没写进去 → 「你没把它写进故事里」", bool(尾a["淡"]) and "没把它写进" in str(尾a["提示"]), str(尾a))
	_收场(a)
	await _等(0.1)

	# ② 写进去了、还活着   （「欢迎回来」在第 3 幕，得先走到那儿）
	var b: Control = await _开局()
	b._点讲者("ban")
	b.局.下一幕()
	b._点讲者("ban")
	b.局.下一幕()
	b._点讲者("tong")
	_ok("走到第 3 幕，手牌里有「%s」" % 口径词表.结尾词,
		口径词表.结尾词 in 口径词表.手牌(3), str(口径词表.手牌(3)))
	b._点词(口径词表.结尾词, -1, -1)
	b.局.说出口()
	# 下一幕会有人接话 —— 这一步是判定"还有没有人记得"的关键
	b.局.引擎.他也说了("k", 口径词表.结尾词)
	b.局.引擎.他也说了("ma", 口径词表.结尾词)
	var 尾b: Dictionary = b.局.取结尾文案()
	_ok("说出口 + 有人跟着说 → 「还有人跟着说」",
		not bool(尾b["划掉"]) and not bool(尾b["淡"]) and "还有人跟着说" in str(尾b["提示"]), str(尾b))

	# 只有你一个人说 → 落在那一种"只剩你一个人在说"
	var b2: Control = await _开局()
	b2._点讲者("ban")
	b2.局.下一幕()
	b2._点讲者("ban")
	b2.局.下一幕()
	b2._点讲者("tong")
	b2._点词(口径词表.结尾词, -1, -1)
	b2.局.说出口()
	var 尾b2: Dictionary = b2.局.取结尾文案()
	_ok("★ 只有你一个人说 → 「只剩你一个人在说」",
		not bool(尾b2["划掉"]) and bool(尾b2["淡"]) and "只剩你一个人" in str(尾b2["提示"]), str(尾b2))
	_收场(b2)
	await _等(0.1)
	_收场(b)
	await _等(0.1)

	# ③ 写进去了、哑了
	var c: Control = await _开局()
	c._点讲者("ban")
	c.局.下一幕()
	c._点讲者("ban")
	c.局.下一幕()
	c._点讲者("tong")
	for _i in 5:
		c.局.引擎.流逝()
	var 尾c: Dictionary = c.局.取结尾文案()
	_ok("写进去但哑了 → 「我念不出来」", bool(尾c["划掉"]) and not bool(尾c["淡"]), str(尾c))
	_收场(c)
	await _等(0.1)


# ============================================================ 草稿
## 改了不算，按「下一幕」才算 —— 而且是随便试。
func _测_草稿() -> void:
	_组("⑥ 草稿：这一秒改的东西，下一秒就该能当没发生过")

	var 实例: Control = await _开局()
	var 引擎: 口径 = 实例.局.引擎

	实例._点讲者("ma")
	实例.局.下一幕()                       # 走到第 2 幕
	实例._点讲者("ma")
	var 原样: Array = 引擎.句子.duplicate(true)

	# ---- 换一个词，然后撤销 ----
	实例._点词("跟了他一路", -1, -1)
	实例.局.开始换词()
	实例._点词("来找他", 1, 2)
	_ok("换词立刻看得见（草稿是当场生效的）",
		引擎.在故事里("跟了他一路") and not 引擎.在故事里("来找他"), str(引擎.句子))
	_ok("按钮变成「草稿生效」", "草稿生效" in 实例._下一幕按钮.text, 实例._下一幕按钮.text)

	实例.局.撤销草稿()
	_ok("★ 撤销之后，故事回到换之前", str(引擎.句子) == str(原样),
		"撤销后 " + str(引擎.句子) + "　／　原本 " + str(原样))
	_ok("替换记录也滚回去了", 引擎.取替换记录().is_empty(), str(引擎.取替换记录()))
	_ok("手记也滚回去了", 实例.局.手记.is_empty(), str(实例.局.手记))
	_ok("撤销按钮自己灰掉", 实例._撤销按钮.disabled)
	_ok("下一幕按钮变回原样", not ("草稿生效" in 实例._下一幕按钮.text), 实例._下一幕按钮.text)

	# ---- 再换一个别的词：只留这一个改动 ----
	实例._点词("骗了他", -1, -1)
	实例.局.开始换词()
	实例._点词("来找他", 1, 2)
	_ok("重新换一个，只有它生效",
		引擎.在故事里("骗了他") and not 引擎.在故事里("跟了他一路"), str(引擎.句子))
	_ok("替换记录只剩一条", 引擎.取替换记录().size() == 1, str(引擎.取替换记录()))

	# ---- 换成别的动作：旧草稿自动撤掉 ----
	实例._点词("那个人", -1, -1)
	实例.局.说出口()
	_ok("★ 换一个动作，会先把旧草稿撤掉", not 引擎.在故事里("骗了他"), str(引擎.句子))
	_ok("新动作生效了", 引擎.是背书的("那个人"), str(引擎.背书标记))
	_ok("替换记录跟着清空", 引擎.取替换记录().is_empty(), str(引擎.取替换记录()))
	_ok("已经说过的词，按钮点不动", 实例._说出口按钮.disabled)

	# ---- 改说法：也自动撤草稿 ----
	实例._点讲者("k")
	_ok("★ 改说法也会先撤掉草稿", not 引擎.是背书的("那个人"), str(引擎.背书标记))
	_ok("说法换成了老K", 实例.局.选中讲者 == "k", 实例.局.选中讲者)
	_ok("第 2 句换成老K的说法了", 引擎.在故事里("骗了他"), str(引擎.句子))

	# ---- 草稿在手时按下一幕，才真的生效 ----
	实例._点词("骗了他", -1, -1)
	实例.局.说出口()
	_ok("草稿在手", 实例.局.动作已做)
	实例.局.下一幕()
	_ok("★ 按下一幕后草稿才生效：下一幕有人接话",
		not 实例.局.本幕回响.is_empty(), str(实例.局.本幕回响))
	_ok("证人数涨了", 引擎.取证人数("骗了他") >= 2, str(引擎.取证人数("骗了他")))
	_ok("草稿落地了（不再是草稿）", not 实例.局.动作已做)

	# ---- 不动手也能走 ----
	for 幕号 in range(3, 8):
		实例._点讲者("ban")
		实例.局.下一幕()
	_ok("什么都不做也能走完", 实例.局.完了)
	_ok("手记里只有那一次说出口", 实例.局.手记.size() == 1, str(实例.局.手记))

	_打印(引擎)
	await _等(9.0)
	_收场(实例)


# ============================================================ 笔记（新手引导）
## 规则不告诉玩家，但撞上之后能查 —— 这就是整个引导。
func _测_笔记() -> void:
	_组("⑦ 笔记：撞上什么才记什么，而且随时能查")

	var 实例: Control = await _开局()

	_ok("开局只有两条（那条横杠 + 你只有这么几次）",
		实例.局.笔记.size() == 2 and 实例.局.笔记.has("杠") and 实例.局.笔记.has("七"),
		str(实例.局.笔记.keys()))
	_ok("还没出手 → 没解锁「说出口」", not 实例.局.笔记.has("说"))
	_ok("还没换过 → 没解锁「换掉」", not 实例.局.笔记.has("换"))
	_ok("按钮上有个点，提示有新东西", "●" in 实例._笔记按钮.text, 实例._笔记按钮.text)

	# 面板能开能收
	实例._开笔记()
	_ok("笔记面板打得开", 实例._笔记层 != null)
	实例._开笔记()
	_ok("再点一次收起来", 实例._笔记层 == null)

	# 悬停说明：没解锁的那部分不剧透
	var 说明: String = 实例.局.词说明("他")
	_ok("没解锁「小点」之前，悬停不告诉你证人数", not "个人说过" in 说明, 说明)

	实例._点讲者("tong")
	var 幕1词: String = str(实例.局.引擎.句子[0][0])
	实例._点词(幕1词, 0, 0)
	实例.局.说出口()
	_ok("★ 说出口之后，解锁「说出口」", 实例.局.笔记.has("说"), str(实例.局.笔记.keys()))
	_ok("出手了 → 手记里有记录了", 实例.局.手记.size() > 0, str(实例.局.手记))

	说明 = 实例.局.词说明(幕1词)
	_ok("解锁之后，悬停会说它被你说过", "说出口过" in 说明, 说明)

	实例.局.下一幕()
	_ok("★ 第一幕走完，解锁「小点」", 实例.局.笔记.has("点"), str(实例.局.笔记.keys()))
	说明 = 实例.局.词说明(幕1词)
	_ok("★ 现在悬停才告诉你证人数", "个人说过" in 说明, 说明)

	实例._点讲者("ban")
	实例._点词("跟了他一路", -1, -1)
	实例.局.开始换词()
	实例._点词(str(实例.局.引擎.句子[1][2]), 1, 2)
	_ok("★ 换过词之后，解锁「换掉一个词」", 实例.局.笔记.has("换"), str(实例.局.笔记.keys()))

	# 走到有词被划掉的那一幕
	for 幕号 in range(3, 8):
		实例._点讲者("ban")
		实例.局.下一幕()
	_ok("★ 有词被划掉之后，解锁「划掉的」", 实例.局.笔记.has("划"), str(实例.局.笔记.keys()))

	_收场(实例)
	await _等(0.2)


# ============================================================ 第四局
## 故意让两句对不上的话同时活到最后 —— 验证"打架的地方"真的会被念出来。
func _第四局_把故事写打架() -> void:
	_组("④ 第四局：故意把故事写打架")

	var 实例: Control = await _开局()
	var 引擎: 口径 = 实例.局.引擎

	for 幕号 in range(1, 8):
		# 第 1 幕要老K的「站了四十分钟」，第 5 幕要同桌的「等一个人」
		var 谁: String = "k" if 幕号 == 1 else ("tong" if 幕号 == 5 else "ban")
		实例._点讲者(谁)
		if 幕号 == 6:
			# 「站了四十分钟」这会儿早就没人提了，把它说出口，救回来
			实例._点词("站了四十分钟", -1, -1)
			_ok("手牌里还有「站了四十分钟」", 实例.局.选中词 == "站了四十分钟", 实例.局.选中词)
			实例.局.说出口()
			_ok("说出口把它从划掉里救回来了", 引擎.取档("站了四十分钟") == 口径.档_事实,
				str(引擎.取清晰("站了四十分钟")))
		实例.局.下一幕()

	_ok("走完了", 实例.局.完了)
	_ok("第 1 幕留下的是「站了四十分钟」", 引擎.在故事里("站了四十分钟"), str(引擎.句子))
	_ok("第 5 幕留下的是「等一个人」", 引擎.在故事里("等一个人"), str(引擎.句子))

	var 矛: Array = 引擎.查矛盾(口径词表.互斥)
	_ok("★ 抓到了一处打架", 矛.size() >= 1, str(矛))
	_ok("★ 两边都还活着才作数", 引擎.取档("站了四十分钟") != 口径.档_哑 and 引擎.取档("等一个人") != 口径.档_哑,
		"%d / %d" % [引擎.取档("站了四十分钟"), 引擎.取档("等一个人")])

	_打印(引擎)
	await _等(11.0)
	_收场(实例)


# ============================================================
func _等(秒: float) -> void:
	await create_timer(秒).timeout


func _打印(引擎: 口径) -> void:
	print("      ┌─ 故事 ──────────────────────")
	for 行 in 引擎.取故事文本():
		print("      │ ", str(行))
	print("      ├─────────────────────────────")
	print("      │ 缝合度 %.2f　%s" % [引擎.缝合度(), str(引擎.统计())])
	var 矛: Array = 引擎.查矛盾(口径词表.互斥)
	print("      │ 打架 %d 处　%s" % [矛.size(), str(矛)])
	print("      └─────────────────────────────")
