func _initialize() -> void:
	print("")
	print("════════ 欢迎回来 · 引擎自检 ════════")
	_跑()
	print("")
	print("════════ 通过 %d · 失败 %d ════════" % [_通过, _失败])
	print("")
	quit(1 if _失败 > 0 else 0)


func _查(名: String, 条件: bool) -> void:
	if 条件:
		_通过 += 1
	else:
		_失败 += 1
		print("  [XX] ", 名)


func _新() -> 引擎:
	return 引擎.new(假故事)


func _跑() -> void:
	_测_装填与攒故事()
	_测_换词与词类()
	_测_候选与听过的词()
	_测_变体()
	_测_互斥与任务()
	_测_快照与念故事()
	_测_故事无关性()


# ============================================================
func _测_装填与攒故事() -> void:
	print("── 装填 / 攒故事")
	局 = _新()
	_查("开局句数为 0", 局.句数() == 0)
	_查("总幕数 = 4", 故事.取总幕数(假故事) == 4)
	_查("取讲者名", 故事.取讲者名(假故事, "a") == "甲")
	_查("词类取得到", 故事.取词类(假故事, "伞") == "物品")
	_查("没这个词时词类为空", 故事.取词类(假故事, "不存在") == "")

	var i: int = 局.追加句子(1, "a", ["他", "门口", "来了"])
	_查("追加句子返回序号 0", i == 0)
	_查("句数为 1", 局.句数() == 1)
	_查("在故事里：他", 局.在故事里("他"))
	_查("在故事里：伞 还没有", not 局.在故事里("伞"))
	_查("故事里的词去重", 局.故事里的词().size() == 3)

	局.追加句子(1, "c", ["她", "门口"])
	_查("第二句进来了", 局.句数() == 2)
	局.撤回最后一句()
	_查("撤回最后一句", 局.句数() == 1)
	局.追加句子(1, "c", ["她", "门口"])


func _测_换词与词类() -> void:
	print("── 换词 / 词类")
	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.追加句子(2, "a", ["他", "门口", "伞"])

	_查("同类可换：他→她", bool(局.可以换("他", "她", 2)["ok"]))
	var 果1: Dictionary = 局.可以换("他", "伞", 2)
	_查("跨类不可换：角色→物品", not bool(果1["ok"]))
	_查("跨类拒绝时给了理由", str(果1["理由"]).contains("同一类"))
	_查("不能换成自己", not bool(局.可以换("他", "他", 2)["ok"]))
	_查("换不存在的词被拒", not bool(局.可以换("他", "没有这个词", 2)["ok"]))
	_查("换不在故事里的词被拒", not bool(局.可以换("包", "伞", 2)["ok"]))

	var 果2: Dictionary = 局.换词("他", "她", 2)
	_查("换词成功", bool(果2["ok"]))
	_查("★ 全局替换：两处一起变", int(果2["处"]) == 2)
	_查("句子里的旧词没了", not 局.在故事里("他"))
	_查("句子里的新词有了", 局.在故事里("她"))
	_查("替换记录 1 条", 局.替换记录.size() == 1)
	var 记: Dictionary = 局.替换记录[0]
	_查("记录里的幕号", int(记["幕"]) == 2)
	_查("记录里的旧词", str(记["旧"]) == "他")
	_查("记录里的新词", str(记["新"]) == "她")
	_查("记录里带词类", str(记["类"]) == "角色")

	# 没听过的词（候选来源=听过的）
	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	var 判: Dictionary = 局.可以换("他", "她", 1)
	_查("★ 第一次改：改成同类词可以（她第1幕就听过）", bool(判["ok"]))
	var 判2: Dictionary = 局.可以换("门口", "车站", 1)
	_查("车站第1幕丁也提过 → 可以", bool(判2["ok"]))


func _测_候选与听过的词() -> void:
	print("── 候选 / 听过的词")
	局 = _新()
	var 一: Array = 局.听过的词(1)
	_查("第1幕听过的词有 他", "他" in 一)
	_查("第1幕没听过 伞（伞在第2幕才出现）", not "伞" in 一)
	_查("第2幕听过 伞", "伞" in 局.听过的词(2))
	_查("第4幕听过的词更多", 局.听过的词(4).size() >= 局.听过的词(1).size())

	var 候: Array = 局.候选(1)
	var 有伞: bool = false
	for 条 in 候:
		if str((条 as Dictionary)["词"]) == "伞":
			有伞 = true
	_查("第1幕候选里没有伞", not 有伞)

	var 候2: Array = 局.候选(4)
	var 类齐: bool = true
	for 条 in 候2:
		if not 故事.词类合法(str((条 as Dictionary)["类"])):
			类齐 = false
	_查("候选里每个词都带合法词类", 类齐)

	# 听过的词拒绝没听过的（「它」是角色类，但四幕里谁都没说过）
	局.追加句子(1, "a", ["他", "门口"])
	var 判: Dictionary = 局.可以换("他", "它", 1)
	_查("★ 换成还没人提过的同类词 → 拒绝", not bool(判["ok"]))
	_查("拒绝理由说清了", str(判["理由"]).contains("还没人提过"))


func _测_变体() -> void:
	print("── 变体（换词 → 下一幕见效）")
	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	var 命1: Dictionary = 局.定幕(2)
	_查("第2幕：没换过 → 不命中变体", int(命1["索引"]) == -1)
	_查("第2幕：事实是原始事实", 局.取事实(2) == "第二幕的事实。")
	_查("第2幕：场景是原始场景", str(局.取场景(2)["背景"]).contains("校园门口"))

	# 换词 → 第3幕（已经定过幕的缓存不该被动到）
	局.换词("他", "她", 2)
	_查("缓存：定过幕的第2幕不重算", 局.取事实(2) == "第二幕的事实。")

	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.换词("他", "她", 1)
	var 命2: Dictionary = 局.定幕(2)
	_查("★ 换过之后第2幕命中第 0 条变体", int(命2["索引"]) == 0)
	_查("变体覆盖了事实", 局.取事实(2) == "被换过的事实。")
	_查("变体覆盖了场景字段（光）", is_equal_approx(float(局.取场景(2)["光"]), 0.9))
	_查("★ 变体没覆盖的字段保留原值（物件）", (局.取场景(2)["物件"] as Array).has("伞"))
	_查("变体改写了说法", str(局.取说法(2)[0]["文"]) == "改过的甲说二")
	_查("★ 变体覆盖了说法的词", (局.取说法(2)[0]["词"] as Array).has("她"))
	_查("★ 第一条命中生效，第二条不再看", str(局.取事实(2)) != "没来版的事实。")
	_查("因为里写清了是你换的", str((命2["因为"] as Array)[0]).contains("换成"))
	_查("所以带上了反应文本", str(命2["所以"]) == "因为你把她换了进来。")
	_查("因果链追加了 1 条", 局.因果链.size() == 1)

	# 定幕缓存
	var 命3: Dictionary = 局.定幕(2)
	_查("定幕是幂等的（缓存）", int(命3["索引"]) == int(命2["索引"]))
	_查("缓存不会重复追加因果链", 局.因果链.size() == 1)

	# 含 / 不含 / 任
	局 = _新()
	局.追加句子(1, "b", ["他", "门口", "没来"])
	var 命4: Dictionary = 局.定幕(2)
	_查("含「没来」→ 命中第 1 条", int(命4["索引"]) == 1)
	_查("含条件覆盖事实", 局.取事实(2) == "没来版的事实。")

	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.追加句子(2, "a", ["他", "包"])
	var 命5: Dictionary = 局.定幕(3)
	_查("「任」条件命中", int(命5["索引"]) == 0)
	_查("任条件覆盖事实", 局.取事实(3) == "任条件命中。")

	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.追加句子(2, "a", ["他", "伞", "下雨"])
	局.追加句子(3, "a", ["他", "包"])
	var 命6: Dictionary = 局.定幕(4)
	_查("「不含」条件：包在故事里 → 不命中", int(命6["索引"]) == -1)

	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.追加句子(2, "a", ["他", "伞", "下雨"])
	局.追加句子(3, "b", ["他", "下雨"])
	var 命7: Dictionary = 局.定幕(4)
	_查("「不含」条件成立 → 命中", int(命7["索引"]) == 0)
	_查("不含条件覆盖事实", 局.取事实(4) == "没有包。")

	# 空条件永不命中
	var 空: 引擎 = _新()
	空.追加句子(1, "a", ["他", "门口"])
	var 假条: Array = [{}]
	_查("空条件不命中", not 空._判条件(假条[0] as Dictionary, []))


func _测_互斥与任务() -> void:
	print("── 互斥 / 任务")
	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	_查("只有「来了」→ 无矛盾", 局.查矛盾().is_empty())
	局.追加句子(1, "b", ["他", "门口", "没来"])
	_查("★ 两个互斥词同时在 → 一处矛盾", 局.查矛盾().size() == 1)
	var 对: Array = 局.查矛盾()[0]
	_查("矛盾对内容正确", [str(对[0]), str(对[1])] == ["来了", "没来"] or [str(对[0]), str(对[1])] == ["没来", "来了"])

	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	var 进1: Dictionary = 局.任务进度()
	_查("任务有 2 条", int(进1["总"]) == 2)
	_查("未达成（还差伞）", not bool(进1["达成"]))
	_查("已满足 1 条（不含对那条已经成立）", int(进1["已满足"]) == 1)
	_查("差什么非空", (进1["差什么"] as Array).size() == 1)
	_查("差的是伞那条", str((进1["差什么"] as Array)[0]).contains("伞"))

	局.追加句子(2, "a", ["他", "伞"])
	var 进2: Dictionary = 局.任务进度()
	_查("伞进来后满足 2 条", int(进2["已满足"]) == 2)
	_查("★ 满足全部条件 → 达成", bool(进2["达成"]))
	_查("达成时不差什么", (进2["差什么"] as Array).is_empty())

	局.追加句子(4, "b", ["他", "包", "没来"])
	var 进3: Dictionary = 局.任务进度()
	_查("「不含对」被触发 → 又掉回 1 条", int(进3["已满足"]) == 1)
	_查("又不达成了", not bool(进3["达成"]))
	_查("差的是不含对那条", str((进3["差什么"] as Array)[0]).contains("不能同时"))

	局.强制达成 = true
	_查("强制达成生效", bool(局.任务进度()["达成"]))
	局.强制达成 = false


func _测_快照与念故事() -> void:
	print("── 快照 / 恢复 / 念故事")
	局 = _新()
	局.追加句子(1, "a", ["他", "门口", "来了"])
	局.换词("他", "她", 1)
	var 存: Dictionary = 局.取快照()
	局.换词("门口", "车站", 1)
	_查("换词后确实变了", 局.在故事里("车站"))
	局.恢复(存)
	_查("★ 恢复：句子回到快照", not 局.在故事里("车站"))
	_查("★ 恢复：替换记录回到快照", 局.替换记录.size() == 1)
	_查("恢复后旧改动的结果还在", 局.在故事里("她"))

	var 行: Array = 局.取故事行()
	_查("取故事行：1 句", 行.size() == 1)
	var 条: Dictionary = 行[0]
	_查("取故事行：带幕号", int(条["幕"]) == 1)
	_查("取故事行：带讲者名", str(条["讲者名"]) == "甲")
	_查("取故事行：带词类", str((条["词"] as Array)[0]["类"]) == "角色")
	_查("★ 取故事行：换过的词被标出来", bool((条["词"] as Array)[0]["换过"]))
	_查("取故事行：带物件绑定", str((条["词"] as Array)[1]["物件"]) == "")
	_查("取故事文本：拼成一行", (局.取故事文本() as Array).size() == 1)

	# 换词后的「换过」标记：第二句里的她也是换来的
	局.追加句子(2, "c", ["她", "伞"])
	var 行2: Array = 局.取故事行()
	_查("两句", 行2.size() == 2)


func _测_故事无关性() -> void:
	print("── 故事无关性 / 零随机（读源码）")
	# ★ 只扫**代码**，不扫注释 —— 注释里正是拿这些词当反例讲的。
	var 源: String = _去注释(FileAccess.get_file_as_string("res://脚本/系统/引擎.gd"))
	_查("引擎源码读得到", 源.length() > 1000)
	for 禁 in ["欢迎回来", "校门口", "同桌", "周迟", "共忆", "妈", "老K", "班主任"]:
		_查("引擎代码里没有「%s」" % 禁, not 源.contains(禁))
	for 别 in ["randi(", "randf(", "shuffle(", "randomize("]:
		_查("引擎里没有 %s" % 别, not 源.contains(别))
	_查("引擎里没有 get_node", not 源.contains("get_node"))
	_查("引擎里没有 Color", not 源.contains("Color"))
	_查("引擎里没有 Control", not 源.contains("Control"))

	var 流源: String = _去注释(FileAccess.get_file_as_string("res://脚本/系统/对局.gd"))
	for 别2 in ["randi(", "randf(", "shuffle("]:
		_查("对局里没有 %s" % 别2, not 流源.contains(别2))
	_查("对局里没有 get_node", not 流源.contains("get_node"))
	_查("对局里没有 Control", not 流源.contains("Control"))
	_查("对局里没有 Color", not 流源.contains("Color"))
	_查("对局里没有 preload 场景", not 流源.contains("preload(\"res://场景"))


## 把整行注释和行尾注释去掉，只留代码。
func _去注释(源: String) -> String:
	var 出: Array = []
	for 行 in 源.split("\n"):
		var 文: String = str(行)
		if 文.strip_edges().begins_with("#"):
			continue
		var 位: int = 文.find("#")
		if 位 >= 0:
			文 = 文.substr(0, 位)
		出.append(文)
	return "\n".join(出)
