## 故事 —— **数据结构约定**，外加一堆只读的工具函数。
##
## ============================================================
## 这个文件里没有一个字是剧情。剧情全在 `脚本/数据/故事_第一案.gd`。
## 换故事 = 换一份这个结构的字典。引擎一行不动（v3 §11）。
## ============================================================
##
## 一份故事长这样：
##
## {
##   "id": "第一案",
##   "名": "欢迎回来",
##
##   "前提": "……",            # 世界观/情境，开场白第一段
##   "身份": "……",            # ★ 你是谁（v3 §3：本故事里你的身份）
##   "任务说明": "……",         # ★ 你要达成什么，开场就知道
##
##   "讲者": [ {"id","名","短","色","立绘":"","位":null} × 4 ],
##                             #   立绘/位 是【美术空位】，空着就降级成占位圆
##
##   "词表": { "词": "类", … },  # 类 ∈ 角色/物品/地点/状态/事件
##   "互斥": [ ["a","b"], … ],   # 两词同时在故事里 = 一处矛盾
##   "物件": { "词": "现场物件id" },   # 【美术空位】，空串 = 现场里没这个东西
##
##   "任务": {
##     "达成": {"含":[…], "不含":[…], "至少":[…], "不含对":[[a,b],…]},
##     "结局台词": "欢迎回来。",
##     "未达成台词": "……",
##   },
##
##   "幕": [ 见下 ],
##
##   "其他达成": [ {"说明","底本":[讲者id…], "替换":[{"幕","旧","新"}…]} ],
##                             # ★ 结算里展示的"另一种合理达成方式"。
##                             #   引擎会**真的跑一遍**去校验它成立，不成立就报错。
## }
##
## 一幕长这样：
##
## {
##   "名": "那句话",
##   "事实": "那个人对他讲了一句话。",              # 中立陈述，白给
##   "场景": {"背景": "", "物件": [], "光": 0.0},   # 【美术空位】
##   "说法": [ {"讲者":"ma","文":"…","词":[…]}, × 4 ],
##   "变体": [
##     {
##       "当": {"含":["欢迎回来"]},          # 条件，见下
##       "事实": "…",      # 可选：覆盖本幕事实
##       "场景": {…},       # 可选：覆盖本幕场景
##       "反应": "…",       # 可选：进因果链的那句话
##       "覆盖": {"tong": {"文":"…"}},        # 可选：覆盖某人的说法
##     },
##   ],
## }
##
## 变体条件语法（纯查表，零 NLP）：
##   "含":   [词…]          这些词现在都在故事里
##   "不含": [词…]          这些词现在都不在故事里
##   "换过": [[旧, 新], …]   发生过这些替换（新写 "*" = 不限定换成什么）
##   "任":   [条件…]        或关系
##   ★ 命中规则：从上往下，**第一条命中的生效**。特例写上面，一般情况写下面。
class_name 故事
extends RefCounted

const 词类表: Array = ["角色", "物品", "地点", "状态", "事件"]


# ============================================================ 工具
static func 取讲者表(数据: Dictionary) -> Array:
	return 数据.get("讲者", [])


static func 取讲者(数据: Dictionary, id: String) -> Dictionary:
	for 人 in 取讲者表(数据):
		if str((人 as Dictionary).get("id", "")) == id:
			return 人
	return {}


static func 取讲者名(数据: Dictionary, id: String) -> String:
	return str(取讲者(数据, id).get("名", id))


static func 取讲者色(数据: Dictionary, id: String) -> Color:
	var 人: Dictionary = 取讲者(数据, id)
	if 人.is_empty():
		return 主题.墨
	return Color(str(人.get("色", "#211c16")))


## 幕号 1 起。越界返回 {}。
static func 取幕(数据: Dictionary, 幕号: int) -> Dictionary:
	var 幕表: Array = 数据.get("幕", [])
	if 幕号 < 1 or 幕号 > 幕表.size():
		return {}
	return 幕表[幕号 - 1]


static func 取总幕数(数据: Dictionary) -> int:
	return (数据.get("幕", []) as Array).size()


## 这一幕里某个人的说法。找不到返回 {}。
static func 取说法(幕: Dictionary, id: String) -> Dictionary:
	for 条 in 幕.get("说法", []):
		if str((条 as Dictionary).get("讲者", "")) == id:
			return 条
	return {}


static func 取词类(数据: Dictionary, 词: String) -> String:
	return str((数据.get("词表", {}) as Dictionary).get(词, ""))


static func 有词(数据: Dictionary, 词: String) -> bool:
	return (数据.get("词表", {}) as Dictionary).has(词)


## 词表里所有词，按声明顺序。
static func 全部词(数据: Dictionary) -> Array:
	return (数据.get("词表", {}) as Dictionary).keys()


## 故事里出现过的物件绑定。空串 = 没绑（美术层不用管）。
static func 取物件(数据: Dictionary, 词: String) -> String:
	return str((数据.get("物件", {}) as Dictionary).get(词, ""))


static func 词类合法(类: String) -> bool:
	return 类 in 词类表


## 给自检和调试用：一份最小的空故事。
static func 空故事() -> Dictionary:
	return {
		"id": "空", "名": "空",
		"前提": "", "身份": "", "任务说明": "",
		"讲者": [], "词表": {}, "互斥": [], "物件": {},
		"任务": {"达成": {}, "结局台词": "", "未达成台词": ""},
		"幕": [], "其他达成": [],
	}
