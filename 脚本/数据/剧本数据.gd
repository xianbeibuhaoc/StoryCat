# ============================================================ 查询
## 取第 N 幕的整张表（幕号从 1 开始）。
static func 取幕(幕号: int) -> Dictionary:
	if 幕号 < 1 or 幕号 > 各幕.size():
		return {}
	return 各幕[幕号 - 1]


## 取某位观众在第 N 幕说的那一段。
static func 取段(幕号: int, 观众id: String) -> Dictionary:
	return 取幕(幕号).get(观众id, {})


## 只要台词。
static func 取文本(幕号: int, 观众id: String) -> String:
	return str(取段(幕号, 观众id).get("文", ""))


## 只要这一段落下的形状。
static func 取关(幕号: int, 观众id: String) -> Array:
	var 关: Variant = 取段(幕号, 观众id).get("关", [])
	return 关 if 关 is Array else []


## 这一幕发生了什么（中立陈述，白给）。
static func 取事实(幕号: int) -> String:
	return str(取幕(幕号).get("事实", ""))


## 这一段被采纳时，喂给别人的是哪一样东西。
static func 取喂物(幕号: int, 观众id: String) -> String:
	return str(喂什么.get("%d:%s" % [幕号, 观众id], ""))


## 取某个讲述者对某样东西的回响句。
static func 取回响句(观众id: String, 意象: String, 偏了: bool) -> String:
	var 条: Dictionary = (回响.get(观众id, {}) as Dictionary).get(意象, {})
	if 条.is_empty():
		return ""
	return str(条.get("驳" if 偏了 else "承", ""))


## 取第 N 幕的场景布局（幕号从 1 开始）。
static func 取布局(幕号: int) -> Dictionary:
	if 幕号 < 1 or 幕号 > 场景布局.size():
		return {}
	return 场景布局[幕号 - 1]


## 一组段落里，一共立起了哪些形状（按 终点名 的顺序返回）。
static func 汇总终点(各段关: Array) -> Array:
	var 结果: Array = []
	for 名 in 终点名:
		for 关 in 各段关:
			if 关 is Array and 名 in 关:
				结果.append(名)
				break
	return 结果


## 按 id 取观众资料。
static func 取观众(id: String) -> Dictionary:
	for 观众 in 观众列表:
		if 观众.get("id", "") == id:
			return 观众
	return {}


## 按 id 取观众名字。
static func 取观众名(id: String) -> String:
	return 取观众(id).get("名字", id)
