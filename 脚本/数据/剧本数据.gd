# ============================================================ 查询接口
## 取某位观众在某一幕给出的那一段（整个字典，含"文"和"关"）。
##
## 幕号从 1 开始。前情 = 上一幕被采纳的观众 id；第 1 幕传空串。
##
## ⚠️ 一阶马尔可夫：每段只看上一幕。全路径是 3^7 = 2187 条，手写填不满。
static func 取段(幕号: int, 前情: String, 观众id: String) -> Dictionary:
	if 幕号 == 1:
		return 第一幕.get(观众id, {})

	var 层: Dictionary = {}
	match 幕号:
		2: 层 = 第二幕
		3: 层 = 第三幕
		4: 层 = 第四幕
		5: 层 = 第五幕
		6: 层 = 第六幕
		7: 层 = 第七幕
		_: return {}

	var 路径: Dictionary = 层.get(前情, {})
	return 路径.get(观众id, {})


## 只要台词。
static func 取文本(幕号: int, 前情: String, 观众id: String) -> String:
	return str(取段(幕号, 前情, 观众id).get("文", ""))


## 只要这一段落下的形状。
static func 取关(幕号: int, 前情: String, 观众id: String) -> Array:
	var 关: Variant = 取段(幕号, 前情, 观众id).get("关", [])
	return 关 if 关 is Array else []


## 一组段落里，一共立起了哪些形状（按 终点名 的顺序返回）。
static func 汇总终点(各段关: Array) -> Array:
	var 结果: Array = []
	for 名 in 终点名:
		for 关 in 各段关:
			if 关 is Array and 名 in 关:
				结果.append(名)
				break
	return 结果


## 按 id 取观众资料。
static func 取观众(id: String) -> Dictionary:
	for 观众 in 观众列表:
		if 观众.get("id", "") == id:
			return 观众
	return {}


## 按 id 取观众名字。
static func 取观众名(id: String) -> String:
	return 取观众(id).get("名字", id)
