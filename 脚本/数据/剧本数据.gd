# ============================================================ 查询接口
## 取某位观众在某一幕给出的文本。
##
## 幕号从 1 开始。
## 前情 = 上一幕被采纳的观众 id；第 1 幕传空串。
##
## ⚠️ 这是 demo 用的"只按上一幕分支"查表法，也就是一阶马尔可夫。
## 路径数随幕数指数增长：3 位观众 × 5 幕 = 3^5 = 243 条前情路径，
## 每幕还得再乘 3 个版本。手写不可能填满。
## 正式版必须换方案，见 脚本/设计笔记.md。
static func 取文本(幕号: int, 前情: String, 观众id: String) -> String:
	match 幕号:
		1:
			return 第一幕.get(观众id, "")
		2:
			var 路径: Dictionary = 第二幕.get(前情, {})
			return 路径.get(观众id, "")
		_:
			return ""


## 一段文本命中了哪些锚点。
static func 命中锚点(文本: String) -> Array:
	var 结果: Array = []
	for 词 in 锚点:
		if 文本.contains(词):
			结果.append(词)
	return 结果


## 按 id 取观众资料。
static func 取观众(id: String) -> Dictionary:
	for 观众 in 观众列表:
		if 观众.get("id", "") == id:
			return 观众
	return {}


## 按 id 取观众名字。
static func 取观众名(id: String) -> String:
	return 取观众(id).get("名字", id)
