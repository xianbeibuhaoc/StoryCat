## 测试用句表 —— **占位内容，不是任何剧本。**
##
## 只为了看清四件事：
##   ① 词会淡、会掉
##   ② 掉了会拖累同句（级联）
##   ③ 「他」在三句话里出现 —— 它一掉，三句话一起空
##   ④ ★ **证人数**：几个人记得这个词，决定它掉多快
##
## ★ 是整个游戏的核心规则，**不告诉玩家**：
##   **只有一个人记得的，最先没。**
##
## 换剧本 = 换这份表。
class_name 测试词表
extends RefCounted

## 一共走多少回合
const 回合数: int = 18

## 每句 = 一串词。
## 「他」在第 1、2、4 句里都出现 —— 故意埋的，演示"共用词一掉带一片"。
const 句表: Array = [
	["他", "走的时候", "没有", "回头"],
	["他", "说过", "会", "回来"],
	["灯", "一直", "亮着"],
	["没有人", "记得", "他"],
]

## ★ 每个词有几个人记得它（1–4）。
## 数字越小越脆。掉得快慢 = 基础衰减 × 结实倍率[证人数]。
##
## 埋了几颗雷：
##   「回头」「一直」「亮着」只有一个人记得 —— 它们会最先没。
const 证人数: Dictionary = {
	"他": 4,
	"走的时候": 3,
	"没有": 3,
	"回头": 1,
	"说过": 2,
	"会": 3,
	"回来": 2,
	"灯": 2,
	"一直": 1,
	"亮着": 1,
	"没有人": 2,
	"记得": 3,
}
