]


static func 取幕景(幕号: int) -> String:
	if 幕号 < 1 or 幕号 > 幕景.size():
		return ""
	return str(幕景[幕号 - 1])


# ============================================================ 查询
static func 取幕(幕号: int) -> Dictionary:
	if 幕号 < 1 or 幕号 > 幕表.size():
		return {}
	return 幕表[幕号 - 1]


static func 取讲述者(id: String) -> Dictionary:
	for 人 in 讲述者:
		if str(人.get("id", "")) == id:
			return 人
	return {}


static func 名字(id: String) -> String:
	return str(取讲述者(id).get("名字", id))


static func 色(id: String) -> String:
	return str(取讲述者(id).get("色", "#ffffff"))


## 每一幕，四个人一共说了哪些词（去重，按出现顺序）。
## 这就是玩家这一幕的**手牌**。
static func 手牌(幕号: int) -> Array:
	var 结果: Array = []
	var 幕: Dictionary = 取幕(幕号)
	for 人 in 讲述者:
		var 条: Dictionary = 幕.get(str(人.get("id", "")), {})
		for 词 in 条.get("词", []):
			var w: String = str(词)
			if not w in 结果:
				结果.append(w)
	return 结果


## 这一幕有哪些讲者说过这个词。
static func 谁说过(幕号: int, 词: String) -> Array:
	var 结果: Array = []
	var 幕: Dictionary = 取幕(幕号)
	for 人 in 讲述者:
		var id: String = str(人.get("id", ""))
		var 条: Dictionary = 幕.get(id, {})
		if 词 in 条.get("词", []):
			结果.append(id)
	return 结果


## 挑一句回响。承 or 顶，看这个人的口径和已经接了几次。
static func 取回响(id: String, 词: String, 顶: bool) -> String:
	var 表: Dictionary = 回响.get(id, {})
	var 池: Array = 表.get("顶" if 顶 else "承", [])
	if 池.is_empty():
		return ""
	var 句: String = str(池[randi() % 池.size()])
	return 句.replace("{词}", 词)


## 一场戏里一共几个词。
static func 总词数() -> int:
	var n: int = 0
	for 幕 in 幕表:
		for 人 in 讲述者:
			var 条: Dictionary = (幕 as Dictionary).get(str(人.get("id", "")), {})
			n += (条.get("词", []) as Array).size()
	return n
