## 色板 —— 亮纸 · 档案卷宗。
##
## ============================================================
## 一句话美术方向
## ============================================================
##   整块屏幕就是**一张摊在灯下的旧纸**。
##   四个人是贴在纸上的四张照片。字是墨。你说的每一句话都是往纸上写字。
##
##   记忆在流失 = **墨迹在变淡**。
##   一个词没了 = **那道墨被划掉了**。
##
## ============================================================
## 用法
## ============================================================
##   色板.纸            底色
##   色板.取墨(档)      0 哑 / 1 传闻 / 2 存疑 / 3 事实  —— 同一个墨的四种浓度
##   色板.你的          你说出口过（黄铜下划线）
##   色板.划            划掉 / 印章（暗朱）
##   色板.线            界面上的淡墨线
##
##   ★ 别再往别处写 #xxxxxx。要改颜色只改这一个文件。
##
## ============================================================
## 为什么四档是"同一色系的四个明度"，不是四个不同颜色
## ============================================================
##   四种色相（比如 蓝灰/暖褐/冷灰/黑）看起来像四个状态指示灯。
##   同一个墨从浓到淡，看起来才是**字在一个一个消失**。
##   这一个决定比画多少张图都影响观感。
class_name 色板
extends RefCounted

# ============================================================ 纸
const 纸 := Color("#d3c7ac")        ## 纸本体
const 纸亮 := Color("#e3d9c2")      ## 被灯照到的地方
const 纸暗 := Color("#bcae91")      ## 背光的地方
const 纸边 := Color("#9a8c72")      ## 纸边、折痕
const 暗角 := Color("#14110e")      ## 纸外面的黑（近黑，暖调）
const 桌 := Color("#0e0c0a")        ## 更外一圈的桌面 / 环境

# ============================================================ 墨（四档）
## 档位常量跟 口径.gd 对齐：0 哑 / 1 传闻 / 2 存疑 / 3 事实
const 墨_事实 := Color("#211c16")    ## 刚写下的浓墨
const 墨_存疑 := Color("#564b3b")    ## 放了一段时间
const 墨_传闻 := Color("#8a7d67")    ## 快看不清了
const 墨_哑 := Color("#a99d86")      ## 只剩个印子，还划了一道

# ============================================================ 强调
const 你的 := Color("#a06f1e")       ## 黄铜 —— 你说出口过。这是你自己的痕迹
const 你的_淡 := Color("#c39a4a")
const 划 := Color("#9c3a2a")         ## 暗朱 —— 划掉、印章
const 划_淡 := Color("#b96a58")

# ============================================================ 界面
const 线 := Color("#8f8268")         ## 淡墨线（框、分隔）
const 线_淡 := Color("#b3a68c")
const 提示 := Color("#6b6152")       ## 提示文字
const 提示_淡 := Color("#8a7f6c")
const 标题 := Color("#3d3529")

# ============================================================ 四个人的墨水
## ★ 这就是"说话人色"。在纸上，它变成**谁的笔**。
##   妈妈那句里冒出一行蓝黑墨，玩家一眼就知道那不是她说的。
const 墨_妈 := Color("#8a4b2a")       ## 褐墨
const 墨_老K := Color("#2f4a6b")      ## 蓝黑墨
const 墨_同桌 := Color("#5b3a6b")     ## 紫墨
const 墨_班主任 := Color("#3f5c43")   ## 墨绿

const _说话人墨 := {
	"ma": 墨_妈,
	"k": 墨_老K,
	"tong": 墨_同桌,
	"ban": 墨_班主任,
}


## 档位 -> 墨色
static func 取墨(档: int) -> Color:
	match clampi(档, 0, 3):
		3: return 墨_事实
		2: return 墨_存疑
		1: return 墨_传闻
		_: return 墨_哑


## 说话人 id -> 墨水色。认不出来就给中性的淡墨。
static func 取说话人墨(id: String) -> Color:
	return _说话人墨.get(id, 线)


## 拿一个 Color 的 hex 字符串（往 tscn / 词表里填的时候用）
static func 十六进制(c: Color) -> String:
	return "#" + c.to_html(false)
