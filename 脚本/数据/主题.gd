## 主题 —— 色、字号、手感旋钮。
##
## ★★ 这个文件是给你改的。改这里不会碰坏任何逻辑 ——
##    引擎和界面只从这里取值，不自己写死数字。
class_name 主题
extends RefCounted

# ============================================================ 手感旋钮
## 替换候选池从哪儿来。
##   "听过的" = 只给"到当前这一幕为止，四个人说过的词"（默认，不会剧透后面几幕）
##   "全部"   = 整个词表都放开
const 候选来源: String = "听过的"

## 每一幕最多能换几次词。v3 §5 写的是"替换一个词"，所以默认 1。
##   0  = 这一幕只能不编辑
##   1  = 默认
##   -1 = 不限
const 每幕替换次数: int = 1

## 按「下一幕」之前，能不能把本幕的替换撤回。
const 允许撤销: bool = true

## 词旁边标不标词类（角色/物品/地点/状态/事件）。
const 显示词类: bool = true

## 任务进度要不要中途显示（v3 §12「优先加强 2：让玩家在中途知道故事正在走向哪里」）。
## 关掉就是盲开。
const 显示任务进度: bool = true

## 调试叠层的开关键。project.godot 里的 InputMap 动作叫「调试开关」，
## 想做别的键，改这里 + 编辑器里改 InputMap，或者直接改这个常量。
const 调试键: int = KEY_F1

## 启动参数：`游戏.exe -- --调试` 一进来就打开调试叠层。
const 启动即调试: String = "--调试"


# ============================================================ 色
## 纸面（和 脚本/shader/纸.gdshader 的 paper_color 保持一致）
const 纸: Color = Color(0.827, 0.780, 0.675)
## 墨：正文
const 墨: Color = Color(0.129, 0.110, 0.086)
## 墨淡：说明文字
const 墨淡: Color = Color(0.420, 0.380, 0.320)
## 墨更淡：提示行
const 墨更淡: Color = Color(0.540, 0.500, 0.420)
## 强调：任务、被选中的东西
const 强调: Color = Color(0.627, 0.435, 0.118)
## 警示：互斥冲突、没达成
const 警示: Color = Color(0.612, 0.227, 0.165)
## 换过的词（结算里标"这个词是你改的"）
const 换过: Color = Color(0.541, 0.353, 0.169)
## 变体命中 / 因果链
const 命中: Color = Color(0.247, 0.361, 0.263)
## 纸上的分隔线
const 线: Color = Color(0.129, 0.110, 0.086, 0.16)

## 词类 → 色。五类各自一个色，一眼能看出"这两个词不是一类"。
const 类色: Dictionary = {
	"角色": Color(0.541, 0.294, 0.165),
	"物品": Color(0.357, 0.227, 0.420),
	"地点": Color(0.184, 0.290, 0.420),
	"状态": Color(0.247, 0.361, 0.263),
	"事件": Color(0.627, 0.435, 0.118),
}


static func 取类色(类: String) -> Color:
	return 类色.get(类, 墨)


