## 默认交互 —— 点选版。
##
## ============================================================
## 玩法：点一个人 → 点故事里的一个词 → 点下面一个同类词。
##
## 它干的事只有一件：把界面报出来的"玩家碰了什么"翻译成 对局 的语义动作。
## 想改成拖拽 / 手势 / 走过去，照抄这个文件改 `装到()` 和那几个 `_当_*` 就行。
##
## ------------------------------------------------------------
## ★ 想做拖拽的骨架（照这个抄就行）：
##
##   func 装到(_宿主: Node) -> void:
##       界面.词块被按下.connect(_起拖)
##       界面.词块被松开.connect(_落拖)
##
##   func _起拖(词, 位置) -> void:
##       玩家选了词(词)              # 抓起来 = 选中
##
##   func _落拖(词, 位置) -> void:
##       var 目标 := 界面.最近的可换目标(位置)   # 界面负责回答"松手落在谁身上"
##       if 目标 != "":
##           玩家要求换(目标, 词)     # ★ 换词是直接传参的，不需要"先选再确认"
##
##   界面只提供"东西在哪儿、谁被碰了"，不提供规则。
## ============================================================
class_name 默认交互
extends 交互


func 装到(_宿主: Node) -> void:
	if 界面 == null:
		return
	if 界面.has_signal("点了讲者"):
		界面.点了讲者.connect(_当_点了讲者)
	if 界面.has_signal("点了故事词"):
		界面.点了故事词.connect(_当_点了故事词)
	if 界面.has_signal("点了候选"):
		界面.点了候选.connect(_当_点了候选)
	if 界面.has_signal("点了撤销"):
		界面.点了撤销.connect(_当_点了撤销)
	if 界面.has_signal("点了下一幕"):
		界面.点了下一幕.connect(_当_点了下一幕)
	if 界面.has_signal("点了重来"):
		界面.点了重来.connect(_当_点了重来)


func 卸下() -> void:
	if 界面 == null:
		return
	for 名 in ["点了讲者", "点了故事词", "点了候选", "点了撤销", "点了下一幕", "点了重来"]:
		if not 界面.has_signal(名):
			continue
		for 连 in 界面.get_signal_connection_list(名):
			var 调: Callable = (连 as Dictionary)["callable"]
			if 界面.is_connected(名, 调):
				界面.disconnect(名, 调)


# ============================================================ 翻译
func _当_点了讲者(id: String) -> void:
	玩家选了底本(id)


func _当_点了故事词(词: String) -> void:
	玩家选了词(词)


## 点候选词 = 用「它」换掉故事里选中的那个词。
func _当_点了候选(词: String) -> void:
	if 局 == null or 局.选中词 == "":
		return
	玩家要求换(局.选中词, 词)


func _当_点了撤销() -> void:
	玩家要求撤销()


func _当_点了下一幕() -> void:
	玩家要求下一幕()


func _当_点了重来() -> void:
	玩家要求重来()
