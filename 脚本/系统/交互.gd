## 交互 —— **契约**。
##
## ============================================================
## ★★ 这个文件只回答一件事：**玩家碰了什么，等于对故事做了什么。**
##
##   界面层负责"画"和"报出玩家碰了什么"（它只会 emit 信号，不知道那意味着什么）。
##   这一层负责"翻译"。
##   规则层（对局）只管执行。
##
##   想换交互（拖拽 / 手势 / 语音 / 走过去）：
##     ① 新写一个脚本继承 交互，或者照着 `默认交互.gd` 抄一份
##     ② 把 `场景/主.tscn` 里 `交互层` 节点的脚本换成你的
##     ③ **别的文件一个字都不用动**
##
##   你的实现里唯一要守的规矩：**只准调 对局 上那几个语义动作**，
##   不许自己去改 引擎 内部的东西，也不许在交互层里写规则判断。
## ============================================================
class_name 交互
extends Node

## 这一层要用的两个对象。`装到` 之前由 主 填好。
var 局: 对局 = null
var 界面: Control = null


## 由 主.gd 调用。
func 绑定(局_: 对局, 界面_: Control) -> void:
	局 = 局_
	界面 = 界面_
	卸下()
	装到(self)


## 子类实现：把输入接上（接界面的信号、接鼠标键盘、建你自己的控件都行）。
func 装到(_宿主: Node) -> void:
	pass


## 子类实现：把接上的东西拆干净（换交互时要调用，别留下悬挂的连接）。
func 卸下() -> void:
	pass


# ============================================================ 语义入口
## ★ 全部交互实现都只该调这几个。它们只是转发，好让"玩家做了什么"在调试里看得见。
func 玩家选了底本(id: String) -> void:
	if 局 == null:
		return
	局.最后提示 = str(局.选底本(id).get("提示", ""))


func 玩家选了词(词: String) -> void:
	if 局 == null:
		return
	局.最后提示 = str(局.选词(词).get("提示", ""))


func 玩家要求换(旧词: String, 新词: String) -> void:
	if 局 == null:
		return
	局.最后提示 = str(局.换词(旧词, 新词).get("提示", ""))


func 玩家要求撤销() -> void:
	if 局 == null:
		return
	局.最后提示 = str(局.撤销().get("提示", ""))


func 玩家要求下一幕() -> void:
	if 局 == null:
		return
	局.最后提示 = str(局.下一幕().get("提示", ""))


func 玩家要求重来() -> void:
	if 局 == null:
		return
	局.重来()
