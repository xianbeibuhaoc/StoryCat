## 美术接口 —— **所有美术接线只准写在这一个文件里。**
##
## ============================================================
## ★★ 为什么单独开一个文件：
##   换美术、加特效、接立绘、改现场 —— 都只动这里。
##   界面层只管字，规则层根本没有"画面"这个概念。
##
##   这里的每一个 `当_*` 都是**降级安全**的：什么都不做，游戏照样跑完。
##   所以你可以一个钩子一个钩子地慢慢填，不会中间坏掉。
##
## ------------------------------------------------------------
## 【美术空位】一共有四个，全在故事数据里，填了就有、空着就没有：
##
##   讲者[i]["立绘"]      ""     → 不画立绘（界面用名字+色条顶上）
##   讲者[i]["位"]        null   → 界面自己排版
##   幕["场景"]["背景"]    ""     → 用 主题.兜底背景 垫着
##   幕["场景"]["光"]      0.0    → 你自己解释这个数字（比如给背景调 exposure）
##   物件[词]             ""     → 这个词在现场里没有对应的东西
##
## ------------------------------------------------------------
## ★ 最重要的一条（"世界跟着故事走"）：
##   故事里的每个词，在现场都可以有一个对应的东西。绑定表是 故事数据 的 `物件`。
##
##     词被换掉     → 那样东西**变了**（`当_换词`）
##     变体命中     → 现场**换了个样子**（`当_场景变了`）
##     任务达成     → 锚定演出（`当_锚定`）
##
##   现场层 / 演出层 两个空节点已经在 `场景/主.tscn` 里留好了，
##   都是全屏 + mouse_filter = IGNORE，不会抢点击。
## ============================================================
class_name 美术接口
extends RefCounted

var 局: 对局 = null
var 现场层: Node = null
var 演出层: Node = null

var _背景: TextureRect = null


func 接上(局_: 对局, 现场层_: Node, 演出层_: Node) -> void:
	局 = 局_
	现场层 = 现场层_
	演出层 = 演出层_

	_搭垫底()

	局.换幕.connect(当_换幕)
	局.场景变了.connect(当_场景变了)
	局.你选了.connect(当_换底本)
	局.你选词.connect(当_选词)
	局.你换了.connect(当_换词)
	局.你撤了.connect(当_撤销)
	局.因果链新增.connect(当_因果链新增)
	局.锚定.connect(当_锚定)
	局.未达成.connect(当_未达成)


# ============================================================ 垫底背景（空位的降级）
## 场景的 `背景` 是空的时候，拿 主题.兜底背景 垫着 —— 这样现在就能看见"现场"，
## 以后有了真美术，把 `背景` 填上，这个垫底就自动让位。
func _搭垫底() -> void:
	if 现场层 == null:
		return
	_背景 = TextureRect.new()
	_背景.name = "兜底背景"
	_背景.set_anchors_preset(Control.PRESET_FULL_RECT)
	_背景.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_背景.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	_背景.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
	_背景.modulate = Color(1, 1, 1, 0.5)
	var 图: Texture2D = null
	if 主题.兜底背景 != "":
		图 = load(主题.兜底背景) as Texture2D
	if 图 != null:
		_背景.texture = 图
	else:
		_背景.visible = false
	现场层.add_child(_背景)
	现场层.move_child(_背景, 0)


# ============================================================
# 钩子 —— 空实现。想画什么就往里写。
# ============================================================

## 换幕了。`场景` = {"背景":"", "物件":[], "光":0.0}（可能被变体覆盖过）
func 当_换幕(幕号: int, 总幕数: int, 幕名: String) -> void:
	var 场景: Dictionary = 局.引擎.取场景(幕号)
	_用场景(场景)
	_埋("换幕", "第 %d/%d 幕 · %s · 场景=%s" % [幕号, 总幕数, 幕名, JSON.stringify(场景)])


## 变体命中了 —— 这一幕的现场跟上一幕不一样了。
func 当_场景变了(场景: Dictionary) -> void:
	_用场景(场景)
	_埋("场景变了", JSON.stringify(场景))


func _用场景(场景: Dictionary) -> void:
	if _背景 == null:
		return
	var 名: String = str(场景.get("背景", ""))
	if 名 == "":
		# 空位：没有真背景，退回垫底
		if 主题.兜底背景 != "":
			_背景.modulate = Color(1, 1, 1, 0.5)
		return
	var 图: Texture2D = load(名) as Texture2D
	if 图 != null:
		_背景.texture = 图
		_背景.visible = true
	# `光` 这个数字怎么解释归你 —— 这里给一个默认读法：透明度。
	var 光: float = float(场景.get("光", 0.0))
	_背景.modulate = Color(1, 1, 1, clampf(0.5 + 光, 0.08, 1.0))


## 玩家采信了某个人的说法。
func 当_换底本(讲者id: String) -> void:
	_埋("换底本", 讲者id)


## 玩家选中了故事里的一个词（准备换掉它）。
func 当_选词(词: String) -> void:
	_埋("选词", "「%s」 ·物件=%s" % [词, 故事.取物件(局.数据, 词)])


## ★ 全局替换发生了。「处数」= 故事里一共有几处跟着变了。
func 当_换词(旧词: String, 新词: String, 处数: int) -> void:
	var 旧物: String = 故事.取物件(局.数据, 旧词)
	var 新物: String = 故事.取物件(局.数据, 新词)
	_埋("换词", "「%s」→「%s」（%d 处）  物件 %s → %s" % [旧词, 新词, 处数, 旧物, 新物])


func 当_撤销() -> void:
	_埋("撤销", "本幕的改写回滚")


func 当_因果链新增(一条: Dictionary) -> void:
	_埋("因果链", "第 %d 幕：因为 %s → %s" % [
		int(一条.get("幕", 0)), "，".join(一条.get("因为", []) as Array), str(一条.get("所以", "")),
	])


## ★ 任务达成 —— 这一版被锚定为世界唯一确认的过去。这是全游戏最该给演出的地方。
func 当_锚定(结果: Dictionary) -> void:
	_埋("锚定", str(结果.get("台词", "")))


func 当_未达成(结果: Dictionary) -> void:
	_埋("未达成", str(结果.get("台词", "")))


# ============================================================
# 埋点：默认只打到控制台。headless 跑自检的时候能看见。
# ============================================================
const 打日志: bool = true


func _埋(事件: String, 内容: String) -> void:
	if 打日志:
		print("[美术] ", 事件, "  ", 内容)
