## 对局 —— 这个游戏的全部规则和状态。**一行界面代码都没有。**
##
## ============================================================
## 这一层不关心：屏幕上有什么、美术长什么样、玩家怎么操作。
## 它只做三件事：
##
##   ① 维护状态（幕 / 故事 / 词 / 手记 / 草稿）
##   ② 暴露**语义动作** —— 选讲者 / 选词 / 说出口 / 换词 / 撤销 / 下一幕
##   ③ 把发生的事用**信号**喊出去，谁想演出谁去接
##
## ============================================================
## 怎么接管界面
## ============================================================
##
##   · 想做拖拽？把「抓起一个词、拖到另一个词上」映射成
##     `选词(词, true)` + `换词(旧词, 新词)`，就行。
##   · 想做手势、语音、画画？随便。只要能落到下面那几个动作上。
##   · 想知道现在该画什么：调 `取状态()`，它返回一个纯数据的字典。
##   · 想让世界跟着故事走：连 `词变档` / `词哑了` 两个信号。
##
## **不要**在这一层里加任何 `get_node` / `Control` / `Color`。
class_name 对局
extends RefCounted

# ============================================================ 信号
## 幕变了。开幕时 是不是开幕 = true。
signal 换幕(幕号: int, 总幕数: int, 是不是开幕: bool)
## 某个人这一幕开口了。是接话 = 他接的是你上一幕说出口的词。
signal 有人开口(讲者id: String, 是接话: bool)
## 你选了谁的说法进故事。
signal 你选了(讲者id: String)
## 你说出口了一个词。在场 = 这一幕有人提过它（别人才会跟着说）。
signal 你说了(词: String, 在场: bool)
## 你换掉了一个词。处数 = 故事里一共有几处跟着变了。
signal 你换了(旧词: String, 新词: String, 处数: int)
## 你撤销了草稿 —— 这一幕当没动过手。
signal 你撤了()
## 某个词的档位变了。旧档/新档 见 口径.档_事实 / 档_存疑 / 档_传闻 / 档_哑。
signal 词变档(词: String, 旧档: int, 新档: int)
## 某个词被划掉了。连累 = 同一句里被它拖下去的词。
signal 词哑了(词: String, 连累: Array)
## 你撞上了一条新规则 —— 笔记该多一条了。
signal 笔记解锁(id: String)
## 七幕走完，进结算。
signal 完局()


# ============================================================ 状态（只读给外面看）
var 引擎: 口径 = 口径.new()
var 幕: int = 0                       ## 0 起算
var 完了: bool = false
var 选中讲者: String = ""
var 选中词: String = ""
var 选中来自手牌: bool = false
var 换词模式: bool = false            ## 界面用：已经拿着一个词，等玩家点目标
var 动作已做: bool = false            ## 这一幕的草稿做了没有
var 手记: Array = []                  ## 你动过的手，结算时念出来
var 本幕回响: Dictionary = {}          ## 讲者id -> 他接的那句话
var 笔记: Dictionary = {}              ## 已解锁的笔记 id

var _传的词: Array = []
var _存档: Dictionary = {}
var _见到过出手: bool = false
var _落过的档: Dictionary = {}         ## 词 -> 上一次的档位，用来判断"刚刚降格了"


func _init() -> void:
	重来()


# ============================================================ 开局 / 重来
func 重来() -> void:
	引擎 = 口径.new()
	幕 = 0
	完了 = false
	选中讲者 = ""
	选中词 = ""
	选中来自手牌 = false
	换词模式 = false
	动作已做 = false
	手记.clear()
	本幕回响.clear()
	笔记.clear()
	_传的词.clear()
	_存档.clear()
	_见到过出手 = false
	_落过的档.clear()
	_解锁("杠")
	_解锁("七")
	_读幕(true)


# ============================================================ 读这一幕
## 把这一幕四个人的话读进来，安排回响，然后喊一声"开幕"。
func _读幕(是不是开幕: bool) -> void:
	if 幕 >= 口径词表.幕表.size():
		return
	var 幕数据: Dictionary = 口径词表.取幕(幕 + 1)
	本幕回响.clear()

	# ① 四个人说的话，全算证词（哪怕你只选一句 —— 你确实都听见了）
	for 人 in 口径词表.讲述者:
		var id: String = str(人["id"])
		引擎.记账(id, 幕数据.get(id, {}).get("词", []))

	# ② 上一幕你说出口的词，这一幕有人接。规则在引擎里。
	for 条 in 引擎.安排回响(幕数据, 口径词表.讲述者, _传的词):
		var id: String = str(条["讲者"])
		var 句: String = 口径词表.取回响(id, str(条["词"]), bool(条["顶"]))
		if 句 != "":
			本幕回响[id] = 句
		有人开口.emit(id, true)

	换幕.emit(幕, 口径词表.幕表.size(), 是不是开幕)


# ============================================================ ★ 语义动作
## ① 选一个人当这一幕的底本。再点同一个人 = 取消。
func 选讲者(id: String) -> bool:
	if 完了:
		return false
	var 幕数据: Dictionary = 口径词表.取幕(幕 + 1)

	# 换说法要先把草稿撤掉，否则撤掉的那句里你的改动会变成幽灵
	if 动作已做 and 选中讲者 != id:
		_回滚()

	if 选中讲者 != "":
		引擎.撤回最后一句()

	if 选中讲者 == id:
		选中讲者 = ""
		你选了.emit("")
		return true

	选中讲者 = id
	引擎.追加句子(幕数据.get(id, {}).get("词", []))
	_记档()
	你选了.emit(id)
	_解锁("点")
	return true


## ② 选中一个词。来自手牌 = 它是这一幕听来的（不是你故事里的）。
func 选词(词: String, 来自手牌: bool) -> bool:
	if 完了:
		return false
	if 选中词 == 词 and 选中来自手牌 == 来自手牌:
		_清选中()
		return true
	选中词 = 词
	选中来自手牌 = 来自手牌
	换词模式 = false
	return true


func 清选中() -> void:
	_清选中()


## ③ 把当前选中的词**说出口**。
##
## ★ 在场 = 这一幕有人提过它。只有在场的词，下一幕才会有人接。
##   不在场也能说，但它只会被你托起来一截 —— 没人替它作证。
func 说出口() -> bool:
	if 完了 or 选中词 == "":
		return false
	var 词: String = 选中词
	_开草稿()
	if 引擎.是背书的(词):
		return false
	var 在场: bool = 词 in 口径词表.手牌(幕 + 1)
	var 之前: int = 引擎.取证人数(词)
	var 之前档: int = 引擎.取档(词)
	引擎.说出口(词, 在场)
	_记一笔({"幕": 幕 + 1, "动作": "说出口", "词": 词, "在场": 在场})
	_记录变更(词, 之前档)
	_见到过出手 = true
	_解锁("说")
	if 之前 <= 1:
		_解锁("孤")
	_清选中()
	你说了.emit(词, 在场)
	_扫档位()
	return true


## ④ 用「新词」换掉故事里的「旧词」。**全局生效**，所有含旧词的句子一起变。
##    ★ 直接传参，不需要"先选再确认" —— 拖拽、手势、语音都随便接。
func 换词(旧词: String, 新词: String) -> bool:
	if 完了 or 旧词 == "" or 新词 == "" or 旧词 == 新词:
		return false
	if not 引擎.在故事里(旧词):
		return false

	var 几处: int = 0
	for 句 in 引擎.句子:
		for w in 句:
			if str(w) == 旧词:
				几处 += 1

	_开草稿()
	var 之前档: int = 引擎.取档(旧词)
	if not 引擎.换词(旧词, 新词, 幕 + 1):
		return false
	_记一笔({"幕": 幕 + 1, "动作": "换词", "旧": 旧词, "新": 新词, "处": 几处})
	_记录变更(旧词, 之前档)
	_记录变更(新词, 口径.档_哑)
	_见到过出手 = true
	_解锁("换")
	_清选中()
	你换了.emit(旧词, 新词, 几处)
	_扫档位()
	return true


## 界面用：进入"拿着这个词，等我点目标"的状态。
func 开始换词() -> bool:
	if 完了 or 选中词 == "":
		return false
	换词模式 = true
	return true


## ⑤ 撤销草稿 —— 这一幕当没动过手。
func 撤销草稿() -> bool:
	if 完了 or not 动作已做:
		return false
	_回滚()
	_清选中()
	你撤了.emit()
	return true


## ⑥ 走下一幕。草稿在这里生效。
func 下一幕() -> bool:
	if 完了 or 选中讲者 == "":
		return false

	_传的词 = 引擎.待传的词()
	var 掉了: Array = 引擎.流逝()
	动作已做 = false
	存档清空()
	_清选中()
	选中讲者 = ""

	幕 += 1
	if 幕 >= 口径词表.幕表.size():
		完了 = true
		_扫档位()
		完局.emit()
		return true

	读下一幕()          # ← 这里会发出 换幕
	_扫档位()           # ← 然后才播"谁死了"（它会覆盖上面的提示，是对的）
	return true


## 幕推进之后读新的一幕（内部用；外面一般只调 下一幕()）
func 读下一幕() -> void:
	_读幕(false)


func 存档清空() -> void:
	_存档.clear()


# ============================================================ 草稿（内部）
func _开草稿() -> void:
	if 动作已做:
		_回滚()
	_存档 = 引擎.快照()


func _回滚() -> void:
	if not 动作已做:
		return
	引擎.恢复(_存档)
	动作已做 = false
	if not 手记.is_empty():
		手记.pop_back()


func _记一笔(条: Dictionary) -> void:
	动作已做 = true
	手记.append(条)


func _清选中() -> void:
	选中词 = ""
	选中来自手牌 = false
	换词模式 = false


# ============================================================ 档位变动 → 信号
func _记档() -> void:
	for w in 引擎.故事里的词():
		var 词: String = str(w)
		_落过的档[词] = 引擎.取档(词)


func _记录变更(词: String, 之前档: int) -> void:
	_落过的档[词] = 之前档


## 扫一遍，把"刚刚降格"和"刚刚划掉"喊出去。
## ★ 这是"世界跟着故事走"的主信号源 —— 现场照着它把对应的东西调暗 / 弄灭。
func _扫档位() -> void:
	for w in 引擎.故事里的词():
		var 词: String = str(w)
		var 新档: int = 引擎.取档(词)
		var 旧档: int = int(_落过的档.get(词, 新档))
		if 新档 == 旧档:
			continue
		_落过的档[词] = 新档
		if 新档 == 口径.档_哑:
			词哑了.emit(词, _同句的(词))
			_解锁("划")
		elif 新档 < 旧档:
			词变档.emit(词, 旧档, 新档)
			if 新档 == 口径.档_传闻:
				_解锁("灰")


## 和这个词同一句的其它词（世界用它演"带塌一片"）
func _同句的(词: String) -> Array:
	var 结果: Array = []
	for 句 in 引擎.句子:
		if not 词 in 句:
			continue
		for 其 in 句:
			var o: String = str(其)
			if o != "" and o != 词 and not o in 结果:
				结果.append(o)
	return 结果


# ============================================================ 笔记
func _解锁(id: String) -> void:
	if 笔记.has(id):
		return
	笔记[id] = true
	笔记解锁.emit(id)


# ============================================================ ★ 取状态
## 外面想知道"现在该画什么"，就调这个。返回**纯数据**，没有引擎内部对象。
##
## 世界跟着故事走要用的东西都在这儿：每个词现在什么档、有几个证人、
## 对应现场哪个物件（看 `口径词表.物件`）。
func 取状态() -> Dictionary:
	var 幕数据: Dictionary = 口径词表.取幕(幕 + 1) if 幕 < 口径词表.幕表.size() else {}

	var 讲者: Array = []
	for 人 in 口径词表.讲述者:
		var id: String = str(人["id"])
		var 条: Dictionary = 幕数据.get(id, {})
		var 台词: String = str(条.get("文", ""))
		if 本幕回响.has(id):
			台词 += "\n" + str(本幕回响[id])
		讲者.append({
			"id": id,
			"名字": str(人["名字"]),
			"短": str(人.get("短", "")),
			"色": str(人.get("色", "#ffffff")),
			"立绘": str(人.get("立绘", "")),          # ← 美术留空位
			"位": 人.get("位", null),                 # ← 美术留空位
			"台词": 台词,
			"词": 条.get("词", []),
			"在说": 选中讲者 == id,
			"接了话": 本幕回响.has(id),
			"这幕说过话": not 条.is_empty(),
		})

	var 故事: Array = []
	for i in 引擎.句子.size():
		var 句: Array = 引擎.句子[i]
		var 行: Array = []
		for j in 句.size():
			var 词: String = str(句[j])
			if 词 == "":
				continue
			行.append(取词状态(词, i, j))
		故事.append({"句号": i, "词": 行})

	var 手牌: Array = []
	if 幕 < 口径词表.幕表.size():
		for w in 口径词表.手牌(幕 + 1):
			var 词: String = str(w)
			手牌.append({
				"词": 词,
				"证人数": 引擎.取证人数(词),
				"色": _词色(词),
				"选中": 选中词 == 词 and 选中来自手牌,
				"已经在故事里": 引擎.在故事里(词),
					"物件": 口径词表.取物件(词),      # ← 世界跟着故事走：这词对应现场哪个东西
				})

	var 数: Dictionary = 引擎.统计()
	return {
		"幕": 幕,
		"总幕数": 口径词表.幕表.size(),
		"幕名": str(幕数据.get("名", "")),
		"事实": str(幕数据.get("事实", "")),        # 这一幕中立发生了什么
		"幕景": 口径词表.取幕景(幕 + 1),          # ← 美术留空位：这一幕的现场
		"完了": 完了,
		"讲者": 讲者,
		"故事": 故事,
		"手牌": 手牌,
		"统计": 数,
		"哑了几个": int(数["哑"]),
		"缝合度": 引擎.缝合度(),
		"草稿": {
			"有": 动作已做,
			"动作": str(手记[-1]["动作"]) if 动作已做 and not 手记.is_empty() else "",
		},
		"可以": {
			"选讲者": not 完了,
			"说出口": not 完了 and 选中词 != "" and not 引擎.是背书的(选中词),
			"换词": not 完了 and 选中词 != "",
			"撤销": not 完了 and 动作已做,
			"下一幕": not 完了 and 选中讲者 != "",
		},
		"笔记": 笔记.keys(),
	}


## 单个词的状态。世界里的物件照着这个调。
func 取词状态(词: String, 句号: int = -1, 槽号: int = -1) -> Dictionary:
	var 档: int = 引擎.取档(词)
	return {
		"词": 词,
		"句号": 句号,
		"槽号": 槽号,
		"档": 档,                       # 0 哑 / 1 传闻 / 2 存疑 / 3 事实
		"清晰": 引擎.取清晰(词),
		"证人数": 引擎.取证人数(词),
		"背书": 引擎.是背书的(词),
		"色": _词色(词),
		"选中": 选中词 == 词 and 句号 >= 0 and not 选中来自手牌,
		"物件": 口径词表.取物件(词),    # ← 世界跟着故事走：这词对应现场哪个东西
	}


## 一个词的来源色：只有一个人说过才上色，多人说过就是中性。
## ★ 错位引用全靠它 —— 妈妈那句里冒出老K的颜色，一眼就看见。
func _词色(词: String) -> Color:
	if not 引擎.谁说过.has(词):
		return Color(0, 0, 0, 0)
	var 人: Dictionary = 引擎.谁说过[词]
	if (人 as Dictionary).size() != 1:
		return Color(0, 0, 0, 0)
	for id in 人:
		return Color(口径词表.色(str(id)))
	return Color(0, 0, 0, 0)


# ============================================================ 悬停说明
## 只说玩家**已经解锁**的那部分，不剧透。
func 词说明(词: String) -> String:
	var 行: Array = ["「%s」" % 词]
	if 笔记.has("点"):
		行.append("有 %d 个人说过它。" % 引擎.取证人数(词))
	if 笔记.has("灰") or 笔记.has("划"):
		match 引擎.取档(词):
			口径.档_事实: 行.append("现在还算结实。")
			口径.档_存疑: 行.append("现在有点虚了。")
			口径.档_传闻: 行.append("现在只有一个人这么说。")
			口径.档_哑: 行.append("没人再提它了 —— 划掉了。")
	if 引擎.是背书的(词):
		行.append("★ 你说出口过。")
	return "\n".join(行)


# ============================================================ 结算
## 结尾那一句怎么念。四种落法，判据是**有几个人说过它**。
func 取结尾文案() -> Dictionary:
	var 词: String = 口径词表.结尾词
	var 在: bool = 引擎.在故事里(词)
	var 哑: bool = 引擎.取档(词) == 口径.档_哑
	var 人: int = 引擎.取证人数(词)

	if not 在:
		return {"提示": "那句话，同桌说过。\n你没把它写进故事里。", "句": "「%s」" % 词, "划掉": false, "淡": true}
	if 哑:
		return {"提示": "最后那句，我念不出来。\n四个人里已经没人再提它了。", "句": "「%s」" % 词, "划掉": true, "淡": false}
	if 人 >= 2:
		return {"提示": "那句话，还有人跟着说。", "句": "「%s。」" % 词, "划掉": false, "淡": false}
	return {"提示": "那句话，到最后只剩你一个人在说。", "句": "「%s。」" % 词, "划掉": false, "淡": true}


func 取校准意见() -> String:
	var 矛盾数: int = 引擎.查矛盾(口径词表.互斥).size()
	var 缝: float = 引擎.缝合度()
	if 矛盾数 == 0 and 缝 >= 0.72:
		return "校准意见：这份记录站得住。四个人的说法对得上，没有一处要打补丁。"
	if 矛盾数 == 0:
		return "校准意见：记录能读。有些地方只有一个人说得上来，算法把它们标了灰 —— 那部分仅供参考。"
	if 矛盾数 <= 2:
		return "校准意见：有 %d 处对不上，已经标黄。它们单看都像真话，摆在一起不是一回事。" % 矛盾数
	return "校准意见：%d 处对不上。这不是一份记录，这是一堆说法。" % 矛盾数


## 结算要念的东西，一次给全。表现层负责演出（什么时候念、念多慢）。
func 取结算() -> Dictionary:
	return {
		"行": 引擎.取故事文本(),
		"原文": 引擎.句子.duplicate(true),
		"矛盾": 引擎.查矛盾(口径词表.互斥),
		"手记": 手记.duplicate(true),
		"校准": 取校准意见(),
		"结尾": 取结尾文案(),
		"统计": 引擎.统计(),
		"缝合度": 引擎.缝合度(),
		"替换记录": 引擎.取替换记录(),
		"几个孤儿": 引擎.哑了的词(),
	}
