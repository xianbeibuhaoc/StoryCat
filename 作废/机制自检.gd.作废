## 机制自检 —— 不需要打开游戏就能验证《口径》引擎。
##
## 跑法（在项目根目录）：
##   Godot_v4.4-stable_win64_console.exe --headless --path . --script res://脚本/测试/机制自检.gd
##
## 退出码 0 = 全过。任何一条挂了返回 1。
##
## ⚠️ 这里验的是**机制**，不是手感。手感只能在游戏里调。
extends SceneTree

const 引擎 := preload("res://脚本/系统/口径.gd")

var _通过: int = 0
var _失败: int = 0


func _ok(名: String, 条件: bool, 补充: String = "") -> void:
	if 条件:
		_通过 += 1
		print("  [OK] ", 名)
	else:
		_失败 += 1
		print("  [XX] ", 名, "　← 实际：", 补充)


func _组(名: String) -> void:
	print("")
	print("── ", 名)


# ============================================================
func _initialize() -> void:
	print("")
	print("════════ 口径 · 机制自检 ════════")

	_测_进场()
	_测_证人数()
	_测_换词()
	_测_说出口()
	_测_传播()
	_测_衰减()
	_测_级联()
	_测_矛盾()
	_测_念故事()

	print("")
	print("════════ 通过 %d · 失败 %d ════════" % [_通过, _失败])
	print("")
	quit(1 if _失败 > 0 else 0)


# ============================================================ 1. 进场
func _测_进场() -> void:
	_组("① 词进场：带着自己那份证词的分量进来")

	var e: 口径 = 引擎.new()
	e.记账("ma", ["他", "遇到", "陌生人"])
	e.记账("k", ["他", "遇到", "陌生人"])
	e.记账("tong", ["他", "外套"])
	e.记账("ban", ["他"])

	_ok("「他」四个人说过 → 证人数 4", e.取证人数("他") == 4, str(e.取证人数("他")))
	_ok("「陌生人」两个人说过 → 证人数 2", e.取证人数("陌生人") == 2, str(e.取证人数("陌生人")))
	_ok("「外套」一个人说过 → 证人数 1", e.取证人数("外套") == 1, str(e.取证人数("外套")))

	e.追加句子(["他", "遇到", "一个", "陌生人"])
	_ok("4 人词进场就是满的", is_equal_approx(e.取清晰("他"), 1.0), str(e.取清晰("他")))
	_ok("2 人词进场 0.78", is_equal_approx(e.取清晰("陌生人"), 0.78), str(e.取清晰("陌生人")))
	_ok("2 人词进场即「事实」档", e.取档("陌生人") == 口径.档_事实, str(e.取档("陌生人")))

	e.追加句子(["他", "穿着", "外套"])
	_ok("孤证进场 0.58 —— 一进来就比事实低一档",
		is_equal_approx(e.取清晰("外套"), 0.58), str(e.取清晰("外套")))
	_ok("孤证进场是「存疑」档，不是「事实」档",
		e.取档("外套") == 口径.档_存疑, str(e.取档("外套")))


# ============================================================ 2. 证人数
func _测_证人数() -> void:
	_组("② 证人数是动态的 —— 连否认都算说过")

	var e: 口径 = 引擎.new()
	e.记账("tong", ["欢迎回来"])
	var 前: int = e.取证人数("欢迎回来")
	# 老K 说「什么欢迎回来，没这回事」—— 系统照样算他说过
	e.他也说了("k", "欢迎回来")
	_ok("否认也算复述：1 → 2", 前 == 1 and e.取证人数("欢迎回来") == 2,
		"%d → %d" % [前, e.取证人数("欢迎回来")])

	e.他也说了("ma", "欢迎回来")
	_ok("三个人说过 → 3", e.取证人数("欢迎回来") == 3, str(e.取证人数("欢迎回来")))
	e.他也说了("ban", "欢迎回来")
	_ok("封顶 4", e.取证人数("欢迎回来") == 4, str(e.取证人数("欢迎回来")))


# ============================================================ 3. 换词（全局）
func _测_换词() -> void:
	_组("③ 换一个词 = 改一整片（全局追溯改写）")

	var e: 口径 = 引擎.new()
	e.记账("ma", ["他", "陌生人"])
	e.记账("k", ["他", "陌生人"])
	e.记账("tong", ["他", "他自己"])

	e.追加句子(["他", "遇到", "一个", "陌生人"])
	e.追加句子(["他", "没有", "认出", "陌生人"])
	e.追加句子(["他", "就是", "他自己"])

	_ok("换之前，两句里有「陌生人」", e.在故事里("陌生人"))
	_ok("换词成功", e.换词("陌生人", "他自己", 3))
	_ok("第一句也被改了（全局）", str(e.句子[0][3]) == "他自己", str(e.句子[0]))
	_ok("第二句也被改了（全局）", str(e.句子[1][3]) == "他自己", str(e.句子[1]))
	_ok("「陌生人」不在故事里了", not e.在故事里("陌生人"))
	_ok("记了一笔替换记录", e.取替换记录().size() == 1)
	_ok("记录里写清了改了几处", int(e.取替换记录()[0].get("处", 0)) == 2, str(e.取替换记录()[0]))

	# ★ 新词带自己的结实度，不跟旧词取长补短
	_ok("用孤证（1 人）改写历史 → 改出来的那片不是「事实」档",
		e.取档("他自己") != 口径.档_事实, str(e.取清晰("他自己")))

	e.换词("他自己", "陌生人", 4)
	_ok("改得回来", e.在故事里("陌生人") and str(e.句子[0][3]) == "陌生人", str(e.句子[0]))

	# 换成 4 人词 → 整片站得住
	var e2: 口径 = 引擎.new()
	e2.记账("a", ["旧说法"])
	e2.记账("b", ["铁证"])
	e2.记账("c", ["铁证"])
	e2.记账("d", ["铁证"])
	e2.追加句子(["旧说法", "在这儿"])
	e2.追加句子(["旧说法", "又来了"])
	e2.换词("旧说法", "铁证", 2)
	_ok("换成 4 人词 → 改出来的那片是「事实」档",
		e2.取档("铁证") == 口径.档_事实, str(e2.取清晰("铁证")))
	_ok("两处一起变", str(e2.句子[0][0]) == "铁证" and str(e2.句子[1][0]) == "铁证", str(e2.句子))

	# 换词不该把没进故事的词凭空算进故事
	_ok("换掉的旧词不再出现在故事里", not e2.在故事里("旧说法"))


# ============================================================ 4. 说出口
func _测_说出口() -> void:
	_组("④ 说出口：孤证当场变事实，并启动下一幕的传播")

	var e: 口径 = 引擎.new()
	e.记账("tong", ["欢迎回来"])
	e.记账("a", ["他说到"])
	e.记账("b", ["他说到"])
	e.追加句子(["他说到", "欢迎回来"])
	for _i in 3:
		e.流逝()
	_ok("先不管它：孤证哑了", e.取档("欢迎回来") == 口径.档_哑, str(e.取清晰("欢迎回来")))

	e.说出口("欢迎回来")
	_ok("说出口 → 托起来一截（孤证 0.58 + 加成 0.30 = 0.88）",
		is_equal_approx(e.取清晰("欢迎回来"), 0.88), str(e.取清晰("欢迎回来")))
	_ok("托起来之后到「事实」档", e.取档("欢迎回来") == 口径.档_事实, str(e.取档("欢迎回来")))
	_ok("★ 光靠你一个人说，它撑不到满 —— 想站稳得有人跟着说",
		e.取清晰("欢迎回来") < 1.0, str(e.取清晰("欢迎回来")))
	_ok("打上了你的金线", e.是背书的("欢迎回来"))
	_ok("进了「待传的词」（下一幕别人会说它）", "欢迎回来" in e.待传的词())

	# 同句**还活着**的词会跟着回血（哑掉的不复活、要另外花一次机会）
	_ok("同句还活着的词也回了血", e.取清晰("他说到") > 0.0, str(e.取清晰("他说到")))

	# ★★ 在场规则：这一幕没人提的词，你说了也没人跟着说
	var f: 口径 = 引擎.new()
	f.记账("tong", ["欢迎回来"])
	f.追加句子(["欢迎回来"])
	f.说出口("欢迎回来", false)               # 不在场
	_ok("不在场 → 还是把它托起来了", f.取清晰("欢迎回来") > 0.85, str(f.取清晰("欢迎回来")))
	_ok("★ 不在场 → 没有人会接话", f.待传的词().is_empty(), str(f.待传的词()))
	_ok("★ 不在场 → 证人数不涨，它到死都是孤证",
		f.取证人数("欢迎回来") == 1, str(f.取证人数("欢迎回来")))
	f.说出口("欢迎回来", true)                # 换一幕，有人在提它了
	_ok("在场 → 进入待传队列", "欢迎回来" in f.待传的词(), str(f.待传的词()))


# ============================================================ 5. ★ 传播（全游戏的地基）
func _测_传播() -> void:
	_组("★ ⑤ 你说的比他们说的重 —— 同一条规则，跑出两个结果")

	# A：什么都不做，就让它自己掉
	var a: 口径 = 引擎.new()
	a.记账("tong", ["欢迎回来"])
	a.追加句子(["欢迎回来"])
	for _i in 3:
		a.流逝()

	# B：你说出口 → 两个人跟着说 → 证人数 1 涨到 3
	var b: 口径 = 引擎.new()
	b.记账("tong", ["欢迎回来"])
	b.追加句子(["欢迎回来"])
	b.说出口("欢迎回来")
	b.他也说了("k", "欢迎回来")      # 老K：什么欢迎回来，没这回事
	b.他也说了("ma", "欢迎回来")     # 妈：……我记得的
	for _i in 3:
		b.流逝()

	_ok("不说的那个，3 回合后已经哑了", a.取档("欢迎回来") == 口径.档_哑, str(a.取清晰("欢迎回来")))
	_ok("说出口的那个，还在", b.取档("欢迎回来") != 口径.档_哑, str(b.取清晰("欢迎回来")))
	_ok("而且高得多（%.2f 对 %.2f）" % [b.取清晰("欢迎回来"), a.取清晰("欢迎回来")],
		b.取清晰("欢迎回来") > a.取清晰("欢迎回来") + 0.3,
		"%.3f vs %.3f" % [b.取清晰("欢迎回来"), a.取清晰("欢迎回来")])
	_ok("★ 孤证被你说成了三个人都承认的事",
		b.取证人数("欢迎回来") == 3, str(b.取证人数("欢迎回来")))


# ============================================================ 6. 衰减
func _测_衰减() -> void:
	_组("⑥ 掉多快，取决于有几个人记得它")

	var e: 口径 = 引擎.new()
	e.记账("a", ["孤证词"])
	e.记账("b", ["共词"])
	e.记账("c", ["共词"])
	e.记账("d", ["共词"])
	e.追加句子(["孤证词"])
	e.追加句子(["共词"])

	_ok("1 人词每回合掉 0.264", is_equal_approx(e.取衰减("孤证词"), 0.264), str(e.取衰减("孤证词")))
	_ok("3 人词每回合只掉 0.121", is_equal_approx(e.取衰减("共词"), 0.121), str(e.取衰减("共词")))
	_ok("3 人词进场 0.92（只有 4 人词才是满的）",
		is_equal_approx(e.取清晰("共词"), 0.92), str(e.取清晰("共词")))

	for _i in 3:
		e.流逝()
	_ok("3 回合后孤证已经哑了", e.取档("孤证词") == 口径.档_哑, str(e.取清晰("孤证词")))
	_ok("同一个 3 回合，共词还剩 0.557",
		is_equal_approx(e.取清晰("共词"), 0.557), str(e.取清晰("共词")))
	_ok("孤证掉得比共词快得多",
		e.取清晰("孤证词") < e.取清晰("共词"),
		"孤证 %.3f / 共词 %.3f" % [e.取清晰("孤证词"), e.取清晰("共词")])

	_ok("全掉光 = 只剩一格空？不 —— 词还在名单里",
		"孤证词" in e.哑了的词(), str(e.哑了的词()))


# ============================================================ 7. 级联
func _测_级联() -> void:
	_组("⑦ 一个词哑了，会带塌同句")

	var e: 口径 = 引擎.new()
	e.记账("a", ["硬词"])
	e.记账("b", ["硬词"])
	e.记账("c", ["硬词"])
	e.记账("d", ["硬词"])
	e.记账("a", ["软词"])
	e.追加句子(["硬词", "软词"])

	e.流逝()
	var 一: float = e.取清晰("硬词")
	e.流逝()
	var 二: float = e.取清晰("硬词")
	e.流逝()                                   # ← 这一回合软词哑，硬词该被拖累
	var 三: float = e.取清晰("硬词")

	var 平掉: float = 一 - 二
	var 塌掉: float = 二 - 三
	_ok("软词死的那一回合，硬词多掉了一大截",
		塌掉 > 平掉 + 0.1,
		"平时掉 %.4f，那回合掉 %.4f" % [平掉, 塌掉])
	_ok("拖累上限生效（没被一波全灭）", 三 > 0.0, str(三))

	# 哑掉的词不消失，还占着原来的位置 —— 故事上留一个洞，不是丢一句话
	var e2: 口径 = 引擎.new()
	e2.记账("a", ["没了的词"])
	e2.追加句子(["他", "说了", "没了的词"])
	for _i in 5:
		e2.流逝()
	_ok("哑掉的词仍然在句子里（位置不置空）", str(e2.句子[0][2]) == "没了的词", str(e2.句子[0]))


# ============================================================ 8. 矛盾
func _测_矛盾() -> void:
	_组("⑧ 自洽检查：纯查表，零 NLP")

	var e: 口径 = 引擎.new()
	e.记账("a", ["他"])
	e.追加句子(["他", "回来了"])
	e.追加句子(["他", "没回来"])
	var 互斥: Array = [["回来了", "没回来"], ["记得", "忘了"]]
	var 矛: Array = e.查矛盾(互斥)
	_ok("找出一处矛盾", 矛.size() == 1, str(矛))
	_ok("矛盾的正是那一对", 矛.size() == 1 and str(矛[0][0]) == "回来了", str(矛))

	e.追加句子(["他", "记得"])
	_ok("没成对的不算矛盾", e.查矛盾(互斥).size() == 1, str(e.查矛盾(互斥)))

	# 划掉的东西不构成冲突
	var e2: 口径 = 引擎.new()
	e2.记账("a", ["回来了"])
	e2.记账("a", ["没回来"])
	e2.追加句子(["回来了"])
	e2.追加句子(["没回来"])
	for _i in 6:
		e2.流逝()
	_ok("两边都划掉了 → 不算矛盾", e2.查矛盾(互斥).size() == 0, str(e2.查矛盾(互斥)))


# ============================================================ 9. 念故事
func _测_念故事() -> void:
	_组("⑨ 念故事：哑的念不出，传闻要加引号")

	var e: 口径 = 引擎.new()
	e.记账("a", ["他"])
	e.记账("b", ["他"])
	e.记账("c", ["他"])
	e.记账("d", ["他"])
	e.记账("a", ["欢迎回来"])
	e.追加句子(["他", "说了", "欢迎回来"])
	for _i in 6:
		e.流逝()

	var 行: Array = e.取故事文本()
	_ok("念出来只有一句", 行.size() == 1, str(行))
	_ok("哑掉的词被包进〖〗（念不出来）",
		行.size() == 1 and "〖欢迎回来〗" in str(行[0]), str(行))

	var 数: Dictionary = e.统计()
	_ok("同句两个孤证都哑了", int(数["哑"]) == 2, str(数))
	_ok("4 人词被级联拖成「传闻」，但没死", int(数["传闻"]) == 1, str(数))
	_ok("总数对得上", int(数["总"]) == 3, str(数))
	_ok("缝合度在 0–1 之间", e.缝合度() > 0.0 and e.缝合度() < 1.0, str(e.缝合度()))

	# 全哑 → 缝合度 0；全满 → 1
	var e2: 口径 = 引擎.new()
	e2.记账("a", ["铁"])
	e2.记账("b", ["铁"])
	e2.记账("c", ["铁"])
	e2.记账("d", ["铁"])
	e2.追加句子(["铁"])
	_ok("四个人的说法 → 缝合度满", is_equal_approx(e2.缝合度(), 1.0), str(e2.缝合度()))
